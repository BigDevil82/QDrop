# Replace this reserved example domain; actual deployment configuration stays in .env.
PUBLIC_DOMAIN=qdrop.example.com
PUBLIC_BASE_URL=https://qdrop.example.com
DATA_DIR=/data
MAX_FILE_BYTES=52428800
MAX_TEXT_BYTES=65536
STORAGE_QUOTA_BYTES=1073741824
DEFAULT_TTL_SECONDS=86400
ACK_GRACE_SECONDS=300
UPLOAD_DEADLINE_SECONDS=1800
LOG_LEVEL=info
# Used only by compose.external-proxy.example.yaml; bind remains loopback-only.
API_BIND_PORT=18080
