  "components": {
    "schemas": {
      "Ack": {
        "properties": {
          "size": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Size"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "size",
          "sha256"
        ],
        "title": "Ack"
      },
      "Draft": {
        "properties": {
          "client_transfer_id": {
            "type": "string",
            "format": "uuid",
            "title": "Client Transfer Id"
          },
          "recipient_device_id": {
            "type": "string",
            "format": "uuid",
            "title": "Recipient Device Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "file"
            ],
            "title": "Kind"
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "mime": {
            "type": "string",
            "maxLength": 128,
            "title": "Mime"
          },
          "size": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Size"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sha256"
          },
          "sensitivity": {
            "type": "string",
            "enum": [
              "normal",
              "sensitive"
            ],
            "title": "Sensitivity",
            "default": "normal"
          },
          "requested_ttl_seconds": {
            "type": "integer",
            "maximum": 86400.0,
            "exclusiveMinimum": 0.0,
            "title": "Requested Ttl Seconds",
            "default": 86400
          },
          "origin_created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Origin Created At"
          },
          "batch_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Batch Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_transfer_id",
          "recipient_device_id",
          "kind",
          "mime",
          "size",
          "sha256",
          "origin_created_at"
        ],
        "title": "Draft"
      },
      "Enrollment": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 128,
            "minLength": 20,
            "title": "Code"
          },
          "device_name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Device Name"
          },
          "platform": {
            "type": "string",
            "enum": [
              "android",
              "windows"
            ],
            "title": "Platform"
          },
          "client_version": {
            "type": "string",
            "maxLength": 32,
            "title": "Client Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "device_name",
          "platform",
          "client_version"
        ],
        "title": "Enrollment"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}